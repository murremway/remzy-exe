<Window x:Class="Yinka.EngineErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yinka — Speech engine error"
        Width="540"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Foreground="#E8E8E8">
  <Border Padding="18">
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="MessageText" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#CFCFCF" LineHeight="20"/>
      <Border BorderBrush="#3C3C3C" BorderThickness="0,1,0,0" Margin="0,16,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
        <Button x:Name="OpenLogBtn" Content="Open speech log" Padding="12,6" Click="OpenLog_Click"/>
        <Button x:Name="SecondaryBtn" Content="" Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed" Click="Secondary_Click"/>
        <Button x:Name="PrimaryBtn"   Content="" Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed" Click="Primary_Click"/>
        <Button x:Name="CloseBtn"     Content="Close"            Padding="12,6" Margin="8,0,0,0" Click="Close_Click" IsCancel="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
