<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Yinka</RootNamespace>
    <AssemblyName>Yinka</AssemblyName>
    <Title>Yinka — KJV verse presenter</Title>
    <Product>Yinka</Product>
    <Authors>Yinka</Authors>
    <Company>Yinka</Company>
    <Description>Offline KJV verse presenter with Windows speech captions and OBS-friendly broadcast output.</Description>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>Assets\Yinka.ico</ApplicationIcon>
    <Copyright>Yinka — KJV verse presenter. KJV text is public domain.</Copyright>
  </PropertyGroup>
  <!--
    UseWindowsForms=true is enabled only so we can call System.Windows.Forms.Screen.AllScreens
    for multi-monitor placement (always written fully qualified at the call sites). Suppress the
    SDK's implicit `using System.Windows.Forms;` and `using System.Drawing;` global usings so
    they don't collide with WPF types like Application, KeyEventArgs, MessageBox, Color, etc.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Older source drops may still contain WindowsSpeechCaptionService.cs. The
      current app uses the ICaptionEngine implementations instead
      (WinRtSpeechEngine/SapiSpeechEngine/WebSpeechEngine/WhisperEngine), so
      keep the obsolete file out of implicit SDK compilation if it is present.
    -->
    <Compile Remove="WindowsSpeechCaptionService.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yinka.Core\Yinka.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Data\en_kjv.json" Link="Data\en_kjv.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!--
    Caption engines and audio meter dependencies.
      NAudio                       - microphone enumeration + 16 kHz capture (audio meter, Whisper).
      System.Speech                - SAPI 5.4 fallback engine, ships with desktop Windows.
      Microsoft.Web.WebView2       - hosts the Web Speech API engine in a hidden Chromium control.
      Whisper.net + Runtime        - offline neural transcription. Default runtime requires
                                     AVX/AVX2/FMA/F16C and Windows 11/Server 2022+.
      Whisper.net.Runtime.NoAvx    - fallback runtime for older CPUs without AVX support.
                                     Whisper.net auto-selects between the two at startup.
    Pinned to 1.9.0 (current stable as of May 2026); 1.7.4 had a known packaging bug
    that broke `dotnet publish` on win-arm64 (missing native binaries in the metapackage).
  -->
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="Whisper.net" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
    <PackageReference Include="Whisper.net.Runtime.NoAvx" Version="1.9.0" />
  </ItemGroup>
</Project>
