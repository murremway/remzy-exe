<Window x:Class="Yinka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yinka — KJV verse presenter (offline text + Windows speech)"
        Height="860"
        Width="1240"
        MinHeight="680"
        MinWidth="980"
        Background="#121212"
        Foreground="{StaticResource TextPrimary}">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Background="#2D6A4F" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
            <TextBlock Text="KJV only (bundled)" FontWeight="SemiBold" Foreground="#F5FFF9"/>
          </Border>
          <TextBlock Text="Broadcast screen" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{StaticResource TextMuted}"/>
          <ComboBox x:Name="ScreenBox" Width="240" VerticalAlignment="Center"/>
          <Button x:Name="OpenBroadcastBtn" Content="Open OBS / broadcast window" Margin="14,0,0,0" Padding="12,6" Click="OpenBroadcast_Click"/>
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="18,0,6,0" VerticalAlignment="Center" Fill="#7A7A7A" ToolTip="Speech engine status"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="380"/>
          <Button x:Name="OpenSpeechLogBtn" Content="Open log" Margin="14,0,0,0" Padding="8,4" Click="OpenSpeechLog_Click" ToolTip="Open speech.log under %LOCALAPPDATA%\Yinka"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <CheckBox x:Name="ChromaObsCheck" Content="Chroma green background (OBS Color Key)" Checked="ObsOptions_Changed" Unchecked="ObsOptions_Changed"/>
          <CheckBox x:Name="Obs1080Check" Content="1920×1080 window (centered on chosen screen)" Checked="ObsOptions_Changed" Unchecked="ObsOptions_Changed"/>
          <CheckBox x:Name="TopmostObsCheck" Content="Broadcast window stays on top" IsChecked="True" Checked="ObsOptions_Changed" Unchecked="ObsOptions_Changed"/>
        </StackPanel>
        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                   Text="OBS: Add Source → Window Capture → pick window titled exactly: “Yinka — OBS Window Capture (KJV verse)”. Use Color Key on the chroma option if you like."/>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="0.95*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="360"/>
      </Grid.RowDefinitions>

      <!-- Transcript + speech -->
      <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,8">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Top" Text="Transcript" FontWeight="SemiBold" Margin="0,0,0,4"/>

          <!-- Engine + mic row -->
          <Grid DockPanel.Dock="Top" Margin="0,2,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Engine" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
            <ComboBox x:Name="EngineBox" Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center"
                      SelectionChanged="EngineBox_SelectionChanged"
                      ToolTip="Pick the speech engine. WinRT uses Windows.Media.SpeechRecognition; SAPI uses the legacy desktop engine; Web Speech uses WebView2/Chromium; Whisper runs offline locally."/>
            <TextBlock Grid.Column="2" Text="Mic" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
            <ComboBox x:Name="MicBox" Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center"
                      SelectionChanged="MicBox_SelectionChanged"
                      ToolTip="Audio input device used for the level meter and the Whisper engine."/>
          </Grid>

          <!-- VU meter -->
          <Grid DockPanel.Dock="Top" Margin="0,0,0,6" Height="10">
            <Border Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="3"/>
            <Border x:Name="MeterFill" Background="#2D6A4F" HorizontalAlignment="Left" Width="0" CornerRadius="3"/>
          </Grid>

          <!-- Capture controls -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="StartCaptionBtn" Content="Start speech caption" Padding="10,5" Click="StartCaption_Click"/>
            <Button x:Name="StopCaptionBtn" Content="Stop" Margin="8,0,0,0" Padding="10,5" Click="StopCaption_Click" IsEnabled="False"/>
            <CheckBox x:Name="PushToTalkCheck" Content="Push-to-talk" Margin="16,0,0,0" VerticalAlignment="Center" Click="PushToTalk_Toggled"/>
            <ComboBox x:Name="PushToTalkKeyBox" Width="120" Margin="6,0,0,0" VerticalAlignment="Center"
                      SelectionChanged="PushToTalkKey_SelectionChanged"
                      ToolTip="Hold this key anywhere in Windows to make Yinka listen; release to stop."/>
            <CheckBox x:Name="AutoScanRefsCheck" Content="Auto-scan refs" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>

          <TextBlock x:Name="HearingLine" DockPanel.Dock="Top" Text="" Foreground="#7EC8E3" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="ScanBtn" Content="Scan for references" Padding="10,5" Click="Scan_Click"/>
            <Button x:Name="SampleBtn" Content="Insert sample lines" Margin="8,0,0,0" Padding="10,5" Click="Sample_Click"/>
            <Button x:Name="SaveTranscriptBtn" Content="Save…" Margin="8,0,0,0" Padding="10,5" Click="SaveTranscript_Click"
                    ToolTip="Save the current transcript to a .txt file with a timestamp header."/>
            <Button x:Name="ClearTranscriptBtn" Content="Clear" Margin="8,0,0,0" Padding="10,5" Click="ClearTranscript_Click"/>
          </StackPanel>
          <TextBox x:Name="TranscriptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
        </DockPanel>
      </Border>

      <!-- Preview / Live -->
      <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,8">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Preview" FontWeight="SemiBold"/>
          <Border Grid.Row="1" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="PreviewRef" FontSize="18" FontWeight="SemiBold" Foreground="#B8E0D2"/>
                <TextBlock x:Name="PreviewBody" TextWrapping="Wrap" FontSize="16" Margin="0,8,0,0" LineHeight="22"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <TextBlock Grid.Row="2" Text="Live (sent to OBS / broadcast window)" FontWeight="SemiBold"/>
          <Border Grid.Row="3" Background="#1A2E24" BorderBrush="#2D6A4F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="LiveRef" FontSize="18" FontWeight="SemiBold" Foreground="#95D5B2"/>
                <TextBlock x:Name="LiveBody" TextWrapping="Wrap" FontSize="16" Margin="0,8,0,0" LineHeight="22"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="LoadPreviewBtn" Content="Load KJV for selected detection" Padding="10,5" Click="LoadPreview_Click"/>
            <Button x:Name="GoLiveBtn" Content="Go live (L)" Margin="8,0,0,0" Padding="10,5" Click="GoLive_Click" ToolTip="Press L when a text box is not focused."/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Queue + detections -->
      <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Top" Text="Detected references" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="LoadKjvBtn" Content="Load KJV into preview" Padding="10,5" Click="LoadKjv_Click"/>
              <Button x:Name="QueueBtn" Content="Add to queue" Margin="8,0,0,0" Padding="10,5" Click="Queue_Click"/>
            </StackPanel>
            <ListBox x:Name="DetectionsList" MouseDoubleClick="DetectionsList_OnMouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayReference}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="Queue" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="PresentFromQueueBtn" Content="Present selected" Padding="10,5" Click="PresentFromQueue_Click"/>
              <Button x:Name="RemoveQueueBtn" Content="Remove" Margin="8,0,0,0" Padding="10,5" Click="RemoveQueue_Click"/>
            </StackPanel>
            <ListBox x:Name="QueueList" MouseDoubleClick="QueueList_OnMouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TranslationName}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </Border>

      <!-- Library tabs: Manual lookup / Bible reader / Hymns / Shortcuts -->
      <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6">
        <TabControl Background="Transparent" BorderThickness="0" Margin="6">
          <!-- Manual lookup -->
          <TabItem Header="Manual lookup">
            <DockPanel Margin="10">
              <TextBlock DockPanel.Dock="Top" Text="Manual lookup (offline KJV)" FontWeight="SemiBold" Margin="0,0,0,6"/>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox x:Name="ManualQueryBox" Width="440" Height="28" VerticalContentAlignment="Center"/>
                <Button x:Name="ManualLookupBtn" Content="Lookup KJV" Margin="8,0,0,0" Padding="14,5" Click="ManualLookup_Click"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"
                         Text="Type something like John 3:16 or Romans 12:1-3. Verse text comes from the bundled en_kjv.json next to the app (no internet)."/>
            </DockPanel>
          </TabItem>

          <!-- Bible reader -->
          <TabItem Header="Bible reader">
            <Grid Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Books -->
              <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Books" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Text="Old Testament" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,2"/>
                <ListBox Grid.Row="2" x:Name="BibleBooksOtList" SelectionChanged="BibleBooksList_SelectionChanged" Tag="OT"/>
                <TextBlock Grid.Row="3" Text="New Testament" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,8,0,2"/>
                <ListBox Grid.Row="4" x:Name="BibleBooksNtList" SelectionChanged="BibleBooksList_SelectionChanged" Tag="NT"/>
              </Grid>

              <!-- Chapters -->
              <DockPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock DockPanel.Dock="Top" x:Name="BibleChaptersTitle" Text="Pick a book" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="BibleChaptersGrid">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>

              <!-- Verses -->
              <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <TextBlock x:Name="BibleVersesTitle" Text="Pick a chapter" FontWeight="SemiBold"/>
                  <TextBlock Text="  ·  Click a verse to preview · Shift-click a second to range"
                             Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="BiblePresentBtn" Content="Display selection" Padding="10,5" Click="BiblePresent_Click" IsEnabled="False"/>
                  <Button x:Name="BibleQueueBtn" Content="+ Queue selection" Margin="8,0,0,0" Padding="10,5" Click="BibleQueue_Click" IsEnabled="False"/>
                  <Button x:Name="BibleClearSelectionBtn" Content="Clear range" Margin="8,0,0,0" Padding="10,5" Click="BibleClearSelection_Click" IsEnabled="False"/>
                </StackPanel>
                <ListBox x:Name="BibleVersesList" SelectionMode="Single"
                         PreviewMouseDown="BibleVersesList_PreviewMouseDown"
                         MouseDoubleClick="BibleVersesList_MouseDoubleClick"
                         HorizontalContentAlignment="Stretch">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="36"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Number}" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Top" TextAlignment="Right" Margin="0,2,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Grid>
          </TabItem>

          <!-- Hymns -->
          <TabItem Header="Hymns">
            <Grid Margin="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Hymn picker -->
              <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <TextBlock Text="Open Hymns (public-domain)" FontWeight="SemiBold"/>
                </DockPanel>
                <TextBox x:Name="HymnSearchBox" DockPanel.Dock="Top" Margin="0,0,0,6" Height="26"
                         VerticalContentAlignment="Center"
                         TextChanged="HymnSearchBox_TextChanged"/>
                <ListBox x:Name="HymnList" SelectionChanged="HymnList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11" Text="{Binding Subtitle}"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>

              <!-- Stanzas -->
              <DockPanel Grid.Column="1">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <TextBlock x:Name="HymnTitle" Text="Pick a hymn" FontWeight="SemiBold"/>
                  <TextBlock Text="  ·  Click a stanza to preview · Double-click to display"
                             Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                  <Button x:Name="HymnPresentStanzaBtn" Content="Display stanza" Padding="10,5" Click="HymnPresentStanza_Click" IsEnabled="False"/>
                  <Button x:Name="HymnQueueStanzaBtn" Content="+ Queue stanza" Margin="8,0,0,0" Padding="10,5" Click="HymnQueueStanza_Click" IsEnabled="False"/>
                  <Button x:Name="HymnPresentAllBtn" Content="Display whole hymn" Margin="20,0,0,0" Padding="10,5" Click="HymnPresentAll_Click" IsEnabled="False"/>
                  <Button x:Name="HymnQueueAllBtn" Content="+ Queue whole hymn" Margin="8,0,0,0" Padding="10,5" Click="HymnQueueAll_Click" IsEnabled="False"/>
                </StackPanel>
                <ListBox x:Name="HymnStanzaList" HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="HymnStanzaList_MouseDoubleClick">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="40"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Label}" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" VerticalAlignment="Top" TextAlignment="Right" Margin="0,2,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14" LineHeight="20"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Grid>
          </TabItem>

          <!-- Shortcuts -->
          <TabItem Header="Shortcuts">
            <DockPanel Margin="10">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12">
                <Run FontWeight="SemiBold" Foreground="White" Text="L"/>
                <Run Text=" — go live from preview to the OBS / broadcast window."/>
                <LineBreak/>
                <Run Text="Double-click a detection or queue row to load it into preview."/>
                <LineBreak/>
                <Run Text="Bible reader: click a verse to preview, Shift-click another to make a range, then "/>
                <Run FontWeight="SemiBold" Foreground="White" Text="Display selection"/>
                <Run Text=" or "/>
                <Run FontWeight="SemiBold" Foreground="White" Text="+ Queue selection"/>
                <Run Text="."/>
                <LineBreak/>
                <Run Text="Hymns: click a stanza to preview, double-click to display, or "/>
                <Run FontWeight="SemiBold" Foreground="White" Text="Display whole hymn"/>
                <Run Text=" to send all stanzas at once."/>
              </TextBlock>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
