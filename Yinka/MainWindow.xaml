<Window x:Class="Yinka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yinka — KJV verse presenter (offline text + Windows speech)"
        Height="860"
        Width="1240"
        MinHeight="680"
        MinWidth="980"
        Background="#121212"
        Foreground="{StaticResource TextPrimary}">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Background="#1E1E1E" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Background="#2D6A4F" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
            <TextBlock Text="KJV only (bundled)" FontWeight="SemiBold" Foreground="#F5FFF9"/>
          </Border>
          <TextBlock Text="Broadcast screen" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="{StaticResource TextMuted}"/>
          <ComboBox x:Name="ScreenBox" Width="240" VerticalAlignment="Center"/>
          <Button x:Name="OpenBroadcastBtn" Content="Open OBS / broadcast window" Margin="14,0,0,0" Padding="12,6" Click="OpenBroadcast_Click"/>
          <TextBlock x:Name="StatusText" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="420"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <CheckBox x:Name="ChromaObsCheck" Content="Chroma green background (OBS Color Key)" Checked="ObsOptions_Changed" Unchecked="ObsOptions_Changed"/>
          <CheckBox x:Name="Obs1080Check" Content="1920×1080 window (centered on chosen screen)" Checked="ObsOptions_Changed" Unchecked="ObsOptions_Changed"/>
          <CheckBox x:Name="TopmostObsCheck" Content="Broadcast window stays on top" IsChecked="True" Checked="ObsOptions_Changed" Unchecked="ObsOptions_Changed"/>
        </StackPanel>
        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                   Text="OBS: Add Source → Window Capture → pick window titled exactly: “Yinka — OBS Window Capture (KJV verse)”. Use Color Key on the chroma option if you like."/>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.15*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="0.95*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="240"/>
      </Grid.RowDefinitions>

      <!-- Transcript + speech -->
      <Border Grid.Column="0" Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,8">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Top" Text="Transcript" FontWeight="SemiBold" Margin="0,0,0,4"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="StartCaptionBtn" Content="Start Windows speech caption" Padding="10,5" Click="StartCaption_Click"/>
            <Button x:Name="StopCaptionBtn" Content="Stop" Margin="8,0,0,0" Padding="10,5" Click="StopCaption_Click" IsEnabled="False"/>
            <CheckBox x:Name="AutoScanRefsCheck" Content="Auto-scan transcript for references" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="HearingLine" DockPanel.Dock="Top" Text="" Foreground="#7EC8E3" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="ScanBtn" Content="Scan for references" Padding="10,5" Click="Scan_Click"/>
            <Button x:Name="SampleBtn" Content="Insert sample lines" Margin="8,0,0,0" Padding="10,5" Click="Sample_Click"/>
            <Button x:Name="ClearTranscriptBtn" Content="Clear" Margin="8,0,0,0" Padding="10,5" Click="ClearTranscript_Click"/>
          </StackPanel>
          <TextBox x:Name="TranscriptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="14"/>
        </DockPanel>
      </Border>

      <!-- Preview / Live -->
      <Border Grid.Column="1" Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,8">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Preview" FontWeight="SemiBold"/>
          <Border Grid.Row="1" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="PreviewRef" FontSize="18" FontWeight="SemiBold" Foreground="#B8E0D2"/>
                <TextBlock x:Name="PreviewBody" TextWrapping="Wrap" FontSize="16" Margin="0,8,0,0" LineHeight="22"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <TextBlock Grid.Row="2" Text="Live (sent to OBS / broadcast window)" FontWeight="SemiBold"/>
          <Border Grid.Row="3" Background="#1A2E24" BorderBrush="#2D6A4F" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,6,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="LiveRef" FontSize="18" FontWeight="SemiBold" Foreground="#95D5B2"/>
                <TextBlock x:Name="LiveBody" TextWrapping="Wrap" FontSize="16" Margin="0,8,0,0" LineHeight="22"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="LoadPreviewBtn" Content="Load KJV for selected detection" Padding="10,5" Click="LoadPreview_Click"/>
            <Button x:Name="GoLiveBtn" Content="Go live (L)" Margin="8,0,0,0" Padding="10,5" Click="GoLive_Click" ToolTip="Press L when a text box is not focused."/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Queue + detections -->
      <Border Grid.Column="2" Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
        <Grid Margin="10">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Top" Text="Detected references" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="LoadKjvBtn" Content="Load KJV into preview" Padding="10,5" Click="LoadKjv_Click"/>
              <Button x:Name="QueueBtn" Content="Add to queue" Margin="8,0,0,0" Padding="10,5" Click="Queue_Click"/>
            </StackPanel>
            <ListBox x:Name="DetectionsList" MouseDoubleClick="DetectionsList_OnMouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayReference}"/>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <DockPanel Grid.Row="1">
            <TextBlock DockPanel.Dock="Top" Text="Queue" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
              <Button x:Name="PresentFromQueueBtn" Content="Present selected" Padding="10,5" Click="PresentFromQueue_Click"/>
              <Button x:Name="RemoveQueueBtn" Content="Remove" Margin="8,0,0,0" Padding="10,5" Click="RemoveQueue_Click"/>
            </StackPanel>
            <ListBox x:Name="QueueList" MouseDoubleClick="QueueList_OnMouseDoubleClick">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding Reference}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TranslationName}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </Border>

      <!-- Manual lookup -->
      <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Top" Text="Manual lookup (offline KJV)" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="ManualQueryBox" Width="440" Height="28" VerticalContentAlignment="Center"/>
            <Button x:Name="ManualLookupBtn" Content="Lookup KJV" Margin="8,0,0,0" Padding="14,5" Click="ManualLookup_Click"/>
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"
                     Text="Verse text is loaded from the bundled en_kjv.json next to the app (no internet). Windows speech can use cloud or offline recognition depending on your Windows language/speech settings."/>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Grid.Row="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6">
        <DockPanel Margin="10">
          <TextBlock DockPanel.Dock="Top" Text="Shortcuts" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12"
                     Text="L — go live from preview to the OBS/broadcast window. Double-click a detection or queue row to load preview."/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
