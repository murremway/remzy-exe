<Window x:Class="Yinka.BroadcastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yinka — OBS Window Capture (KJV verse)"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="#0D1117"
        Foreground="#F0F6FC"
        Topmost="True">
  <Grid x:Name="RootGrid" Margin="48">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="ReferenceBlock"
               Grid.Row="0"
               FontSize="36"
               FontWeight="SemiBold"
               TextWrapping="Wrap"
               Margin="0,0,0,24"
               Opacity="0.95"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="VerseBlock"
                 FontSize="42"
                 LineHeight="58"
                 TextWrapping="Wrap"
                 FontFamily="Georgia, Times New Roman, serif"/>
    </ScrollViewer>
  </Grid>
</Window>
