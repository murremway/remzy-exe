<Application x:Class="Yinka.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9A9A9A"/>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#252526"/>
      <Setter Property="Foreground" Value="#E8E8E8"/>
      <Setter Property="BorderBrush" Value="#3C3C3C"/>
      <Setter Property="CaretBrush" Value="#E8E8E8"/>
      <Setter Property="Padding" Value="6"/>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="#252526"/>
      <Setter Property="Foreground" Value="#E8E8E8"/>
      <Setter Property="BorderBrush" Value="#3C3C3C"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8E8E8"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
  </Application.Resources>
</Application>
